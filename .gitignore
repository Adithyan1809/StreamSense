```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
rag_venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml

# Generated local data and vector databases
chroma/
chroma_db/
chroma_langchain_db/
*.sqlite
*.sqlite3

# Ignore everything inside tests
tests/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
```
